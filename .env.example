# Postgres. Locally: `docker compose up -d` and use the URLs below.
# On Vercel with Neon these are set for you (DATABASE_URL is pooled, DATABASE_URL_UNPOOLED is direct).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/financehub"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/financehub"

# Secret used to sign session cookies — set a long random string in production
AUTH_SECRET="change-me-to-a-long-random-string"

# Market data provider, one of the names registered in src/lib/market/providers.ts:
# "yahoo" (live data, falls back to demo data on failure) or "mock" (demo data only)
MARKET_DATA_PROVIDER="yahoo"
